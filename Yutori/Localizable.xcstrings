      }
    },
    "This bowl is still being prepared": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este bowl todavía se está preparando"
          }
        }
      }
    },
    "This cannot be undone. Bowl progress, collected bowls and unlock progress earned from these sessions will be removed. Your courses and profile will be kept.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción no se puede deshacer. Se eliminarán el progreso de los bowls, los bowls coleccionados y los desbloqueos conseguidos con estas sesiones. Tus cursos y tu perfil se conservarán."
          }
        }
      }
    },
    "This deletes all local sessions, courses, collected bowls, progress, profile and settings. You'll start from zero. This cannot be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán todas las sesiones, cursos, bowls coleccionados, el progreso, el perfil y los ajustes guardados en este dispositivo. Empezarás desde cero y no podrás deshacerlo."
          }
        }
      }
    },
    "This option will work as soon as Yutori is available on the App Store.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta opción funcionará cuando Yutori esté disponible en el App Store."
          }
        }
      }
    },
    "This session will be removed and your bowl progress and collection will be recalculated.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión se eliminará y volveremos a calcular el progreso de tus bowls y tu colección."
          }
        }
      }
    },
    "This study time won't be saved or added to your dish.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tiempo de estudio no se guardará ni se añadirá a tu bowl."
