    "88 percent of university students struggle to study consistently for more than a week": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El 88 por ciento de los universitarios tiene dificultades para estudiar de forma constante durante más de una semana"
